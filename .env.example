# Backend
# Folder with the imported Flushing pilot (default: data/pilot)
REST_ROUTE_PILOT_DIR=data/pilot

# Frontend (Vite, read at build time)
# Leave VITE_API_BASE empty when the backend serves the frontend (same origin).
VITE_API_BASE=
# Map tiles. The default is the OpenStreetMap standard tile server, which is
# fine for a small pilot under its tile usage policy (visible attribution, no
# bulk downloading). Replace for heavier use.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Walking areas built from the committed NYC data (persistent single-process backend)
# REST_ROUTE_AREA_CACHE=/absolute/path/to/areas
# REST_ROUTE_GEOCODER_URL=https://photon.komoot.io/api/
